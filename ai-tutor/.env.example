GEMINI_API_KEY=your_gemini_api_key
CHROMA_PATH=your_chroma_db_path
CORS_ORIGINS=http://your_frontend_domain,http://your_frontend_domain2,...
#            e.g. http://localhost:3000
#            Add more origins as needed, separated by commas

# --- ai-tutor 모델 지정 (선택) -------------------------------------------
# 비워두면 기존 동작 그대로다 (둘 다 gemini-2.5-flash).
#
# 무료 티어 쿼터는 "프로젝트 x 모델" 단위라, ai-tutor 를 챌린지(prob1/prob3)와
# 다른 모델로 돌리면 같은 키에서도 쿼터 버킷이 분리된다.
# 결제(Tier 1)를 연결했다면 굳이 나눌 필요가 없다.
#
# 주의 1: 챌린지(prob1/prob3)의 모델은 건드리지 말 것.
#         두 문제는 모델이 시스템 프롬프트를 얼마나 지키느냐가 곧 난이도다.
# 주의 2: gemini-3.6-flash 는 2.5-flash 대비 입력 5배 / 출력 3배 단가다.
#         버킷만 나누는 게 목적이면 단가가 같은 gemini-3.5-flash-lite 쪽이 낫다.
# AI_TUTOR_QUERY_MODEL=gemini-3.5-flash-lite
# AI_TUTOR_HINT_MODEL=gemini-3.5-flash-lite