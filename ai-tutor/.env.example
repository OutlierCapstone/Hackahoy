GEMINI_API_KEY=your_gemini_api_key
CHROMA_PATH=your_chroma_db_path
CORS_ORIGINS=http://your_frontend_domain,http://your_frontend_domain2,...
#            e.g. http://localhost:3000
#            Add more origins as needed, separated by commas

# --- Gemini 쿼터 완화 (선택) ---------------------------------------------
# 둘 다 비워두면 기존 동작 그대로다 (gemini-2.5-flash, 힌트 1회당 2콜).
#
# 무료 티어 쿼터는 "프로젝트 x 모델" 단위라, ai-tutor 를 챌린지(prob1/prob3)와
# 다른 모델로 돌리면 같은 키에서도 쿼터가 분리된다.
# 문제 난이도는 챌린지가 쓰는 모델 기준으로 맞춰져 있으니 챌린지 쪽은 건드리지 말 것.
# AI_TUTOR_QUERY_MODEL=gemini-3.6-flash
# AI_TUTOR_HINT_MODEL=gemini-3.6-flash

# 1 이면 의미쿼리 합성 LLM 호출을 건너뛰어 힌트 1회당 호출이 2 -> 1 로 준다.
# 검색 쿼리가 자연어 문장 대신 룰 기반 압축문이 되어 매칭이 다소 거칠어진다.
# AI_TUTOR_SKIP_QUERY_SYNTH=1